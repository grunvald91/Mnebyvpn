[Unit]
Description=MNEBYVPN FI one-use registration on existing controller188
Documentation=https://github.com/grunvald91/Mnebyvpn
After=network-online.target
Wants=network-online.target
ConditionPathExists=/root/mnebyvpn-controller/approvals/fi-enrollment.enable
ConditionPathExists=/root/mnebyvpn-controller/config/fi-enrollment.env
ConditionPathExists=/root/mnebyvpn-controller/fi-known_hosts
ConditionPathExists=/root/mnebyvpn-controller/fi-node-public.spki
ConditionPathExists=/root/mnebyvpn-controller/controller-signing-key.pem

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/mnebyvpn-controller/current
EnvironmentFile=/root/mnebyvpn-controller/config/fi-enrollment.env
ExecStart=/opt/mnebyvpn-controller/current/bin/node --experimental-strip-types /opt/mnebyvpn-controller/current/apps/service/src/fi-enrollment-controller.ts
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
IPAddressAllow=217.11.167.91/32
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
TasksMax=64
MemoryMax=256M
TimeoutStartSec=75s
