# Test-only loopback profile: no public port and no anonymous recursive DNS.
tls://.:1853 {
    bind 127.0.0.1
    tls certs/dns.test.invalid.crt certs/dns.test.invalid.key
    acl {
        allow net 127.0.0.1/32
        block
    }
    cache 30
    forward . tls://9.9.9.9 {
        tls_servername dns.quad9.net
        health_check 5s
        max_concurrent 64
    }
}
